# Hugging Face Space hosting a Gradio text-to-video app.
# Find a public Space with a text-to-video endpoint and set these values.
HF_SPACE_ID=your-username/your-text-to-video-space
HF_TOKEN=
# Exact Gradio API endpoint name from the Space's View API page.
HF_API_NAME=/text_to_video
# JSON array of input arguments. {{prompt}} is replaced server-side.
# Example for a Space with one text input:
HF_INPUTS_JSON=["{{prompt}}"]
